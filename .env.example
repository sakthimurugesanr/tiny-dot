# Canonical production URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Publish only a verified email address
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: absolute private persistent directory on a self-hosted Node server.
# Do not use public/, a temporary directory, or serverless ephemeral storage.
# Leave empty to disable sending. Vercel deployments always disable disk submissions.
COMMISSION_STORAGE_DIR=
# Booking requests use private-data/bookings by default on a self-hosted Node server.
# Optional override: absolute path to a private persistent directory, outside public/.
# Vercel/serverless disk bookings are disabled; use durable storage before enabling there.
BOOKING_STORAGE_DIR=
